  "fixes": [
    {
      "issue": "Identical declarations hid changes in the effective specificity of matching rules and selector-list arms.",
      "solution": "Parse selector syntax with cached standard libraries; re-evaluate matching arms against current DOM and fingerprint relative specificity among declarations competing within the same property, importance and layer.",
      "checks": [
        "State change and ID/list-arm changes retire 50px panel / 220px image corrections.",
        "Equal-specificity state rules, reordered lists and increased scores with unchanged precedence retain stable corrections.",
        "Functional pseudo-classes, escaped identifiers, attribute commas and namespaces are checked against native browser cascades."
      ],
      "parsingBudget": {
        "maxSelectorLength": 16384,
        "maxNestingDepth": 64
      }
    },
    {
      "issue": "Zero-sized overflow ancestors unconditionally pruned visibly positioned descendants.",
      "solution": "Separate semantic hiding from clipping, share the composed containing-block chain with negative-indent filtering, and keep escaped source hosts independent of zero-sized wrappers in both synchronous and cooperative collection.",
      "checks": [
        "Visible absolute/fixed descendants remain eligible.",
        "True clipping, padding/border cases, display/visibility/opacity hiding and containing blocks retain their policies.",
        "Rich markup, links, inline code, shadow sources and assigned slots preserve source ownership."
      ]
    }
  ],
